<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>lys</vendor>
  <vendor_url>https://github.com/stubbedev/lys-login</vendor_url>
  <action id="dev.stubbe.lys.login.apply-config">
    <description>Change the login screen</description>
    <message>Authentication is required to change the login screen</message>
    <icon_name>preferences-desktop-display</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
